<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_compteur"
        android:textSize="18sp"
        android:textColor="@color/couleur_primaire"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/affichageValeur"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="80sp"
        android:textStyle="bold"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/boutonAugmenter"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_augmenter"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/boutonDiminuer"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_diminuer"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/boutonRemettre"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_reinitialiser" />

</LinearLayout>
